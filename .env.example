# Copy to .env for local nhost CLI use, and set the same keys as
# Secrets in the nhost dashboard for the deployed project (Settings →
# Environment Variables / Secrets) so functions/ can read them via
# process.env.

# Used by every function in functions/lib/hasura.ts to call Hasura
# with admin rights. In the deployed project these are already
# available automatically as NHOST_GRAPHQL_URL / NHOST_ADMIN_SECRET —
# only needed here for local `nhost dev`.
NHOST_GRAPHQL_URL=https://<subdomain>.graphql.<region>.nhost.run/v1
NHOST_ADMIN_SECRET=

# LLM API key for the llm_call step (functions/lib/steps.ts). Any
# OpenAI-compatible chat completions endpoint works — Groq and
# OpenRouter both do on their free tiers. Leave unset to use the
# disclosed stub fallback (1.2s artificial delay, clearly labeled in
# the output).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant
